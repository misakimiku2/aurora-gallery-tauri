{
  "name": "aurora-gallery",
  "private": true,
  "version": "1.1.3",
  "author": "MISAKIMIKU",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/misakimiku2/aurora-gallery-tauri"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:lan-share": "vite build --config vite.config.lan-share.ts",
    "dev:lan-share": "npm run build:lan-share && npm run clean:dev",
    "clean": "powershell -ExecutionPolicy Bypass -File scripts/clean.ps1",
    "clean:full": "powershell -ExecutionPolicy Bypass -File scripts/clean.ps1 -RemoveTarget",
    "clean:build": "npm run clean && npm run build",
    "clean:dev": "npm run clean && npm run tauri:dev",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:android:dev": "node scripts/android-dev.mjs",
    "tauri:android:dev:reuse": "node scripts/android-dev-reuse.mjs",
    "android:deploy-extra": "node scripts/android-deploy-extra.mjs",
    "tauri:build": "tauri build",
    "test": "vitest"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-log": "^2.7.1",
    "@vladmandic/face-api": "^1.7.12",
    "html5-qrcode": "^2.3.8",
    "jszip": "^3.10.1",
    "lucide-react": "^0.344.0",
    "md5": "^2.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-window": "^2.2.6",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/md5": "^2.3.5",
    "@types/node": "^25.0.2",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "jsdom": "^22.1.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.4",
    "vitest": "^1.1.5"
  }
}
