# Tauri
src-tauri/target

# 游离的缩略图缓存目录：正常应在「资源根」下；若某个流程把节点 id（generateId =
# md5(path)[0..9]）当成根路径传下去，会在 cwd 下建出 <9位hex>/.Aurora_Cache。
# 2026-10-14 观察到一次（src-tauri/491b65a0d/.Aurora_Cache），此处防御性忽略。
.Aurora_Cache/

# Tauri generated artifacts
src-tauri/gen/schemas/
src-tauri/metadata.json
src-tauri/vendor/
# LAN share web client build output (regenerated by build:lan-share, embedded via include_str!)
src-tauri/static/lan-share/

# Accidental temp file
/temp_api.ts

/clockit_backup_*.csv

# M0 Kotlin 版 PoC（新增工程，编译产物不提交）
ffi-poc/target/
core/target/
# 编辑器 v3：photocraft 引擎 vendor 与桥 crate 的编译产物（本机有全局 CARGO_TARGET_DIR，其他机器可能就地生成）
photocraft-vendor/target/
editor/target/
kotlin-app/.gradle/
kotlin-app/build/
kotlin-app/app/build/
kotlin-app/build2/
kotlin-app/local.properties
# Release 签名（正式 keystore 与密码，绝不进 git——丢了将无法给已装用户推应用内更新）
kotlin-app/keystore.properties
kotlin-app/keystore/
release-out/

# 本地诊断产物（模拟器截图/取证的数据库副本等，2026-10-08 起）
aurora_diag_tmp/

# vitest 模块交换目录（vitest.config.ts 把 TEMP 重定向到这里——沙箱适配，2026-10-16）
.vitest-tmp/
