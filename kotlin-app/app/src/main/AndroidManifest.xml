<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- MediaStore 图片读取（Android 13+ 用 READ_MEDIA_IMAGES，更低版本用 READ_EXTERNAL_STORAGE）。
         不设 maxSdkVersion：targetSdk < 33 时 Android 13+ 的媒体读走 READ_EXTERNAL_STORAGE
         映射（READ_MEDIA_IMAGES 只对 targetSdk ≥ 33 的应用生效），声明掐了会拿残缺索引。 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- targetSdk < 33 时系统不生效，留着：将来 targetSdk 升回 33+ 时直接可用 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- 不设 maxSdkVersion：targetSdk 29 在 R+ 上自动拿传统存储视图后，直写共享存储
         仍以 WRITE_EXTERNAL_STORAGE 为准（运行时由 requestWriteAccess 的 <30 分支请求）。 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- M4b 阶段 5：扫描进度/完成通知（API 33+ 运行时请求，拒绝则仅无通知） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- M6a 0.7 spike：LAN 直连桌面服务端（HTTP 客户端 / Coil http fetcher 都需要）；
         ACCESS_NETWORK_STATE 留给阶段 3 LanClient 的心跳/断线判断 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- M6a 阶段 7 前台服务保活 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- D50：应用内更新——下载 APK 后唤起系统安装界面。
         这不是运行时权限弹窗，而是「特殊权限」：首次安装需用户在系统设置里打开
         「允许来自此来源的应用」（ApkDownloader.unknownSourcesIntent 会引导过去）。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 2026-09-28 免弹窗主路径：管理媒体（特殊权限，API 31+，不弹运行时窗）。
         授予后 createDeleteRequest 由系统静默执行（删除零弹窗，真机实测）；但华为
         对 update（改名/移动）仍要求逐张授权，故它不是「一次授权永久免弹」的终解。 -->
    <uses-permission
        android:name="android.permission.MANAGE_MEDIA"
        tools:ignore="ProtectedPermissions" />

    <!-- 2026-09-28 终版：所有文件访问（特殊权限，API 30+，Solid Explorer 同款）。
         MediaStore 的 createWriteRequest 授权是**按单张**的（改另一张会再弹）；只有
         授予它之后，直写 update/delete/insert 一律放行，才真正做到「一次开启、此后再
         无任何系统授权弹窗」。MainActivity.withMediaWriteConsent 在被拦时引导一次，
         引导期间待执行的操作持久化在 SharedPreferences，回程 onResume 自动续跑。 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 10（Q）分区存储豁免：配 targetSdk 29 生效传统存储视图，四种文件操作
         （删除/重命名/移动/复制）直写放行。R+ 上 targetSdk ≤ 29 自动传统视图，本属性被忽略。 -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.AuroraKotlin">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:theme="@style/Theme.AuroraKotlin">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- M6a 阶段 7：对等服务端前台保活（通知栏「停止共享」回传 ACTION_STOP） -->
        <service
            android:name=".LanServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- D50：更新 APK 的临时读授权出口（filesDir/updates/，路径见 res/xml/file_paths.xml）。
             authorities 必须与 ApkDownloader 里 `${packageName}.fileprovider` 一致。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
