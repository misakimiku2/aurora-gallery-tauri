<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- MediaStore 图片读取（Android 13+ 用 READ_MEDIA_IMAGES，更低版本用 READ_EXTERNAL_STORAGE） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- M4b 1.1：API < 30 的重命名/移动兜底（更高版本走 createWriteRequest，不需要这条） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- M4b 阶段 5：扫描进度/完成通知（API 33+ 运行时请求，拒绝则仅无通知） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- M6a 0.7 spike：LAN 直连桌面服务端（HTTP 客户端 / Coil http fetcher 都需要）；
         ACCESS_NETWORK_STATE 留给阶段 3 LanClient 的心跳/断线判断 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- M6a 阶段 7 前台服务保活 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AuroraKotlin">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:theme="@style/Theme.AuroraKotlin">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- M6a 阶段 7：对等服务端前台保活（通知栏「停止共享」回传 ACTION_STOP） -->
        <service
            android:name=".LanServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
