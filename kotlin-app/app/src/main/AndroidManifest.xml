<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- MediaStore 图片读取（Android 13+ 用 READ_MEDIA_IMAGES，更低版本用 READ_EXTERNAL_STORAGE） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- M4b 1.1：API < 30 的重命名/移动兜底（更高版本走 createWriteRequest，不需要这条） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- M4b 阶段 5：扫描进度/完成通知（API 33+ 运行时请求，拒绝则仅无通知） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AuroraKotlin">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:theme="@style/Theme.AuroraKotlin">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- M5 阶段 0.2 渲染 spike（一次性，结论落清单后连同本行一起删除） -->
        <activity
            android:name=".spike.CanvasSpikeActivity"
            android:exported="true"
            android:theme="@style/Theme.AuroraKotlin" />
    </application>

</manifest>
